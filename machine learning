import re
import joblib
import pandas as pd
import matplotlib.pyplot as plt
from typing import List, Dict, Any
from sklearn.pipeline import Pipeline
from sklearn.ensemble import HistGradientBoostingRegressor
# enable the experimental halving search
from sklearn.experimental import enable_halving_search_cv  # noqa
from sklearn.model_selection import (
    train_test_split,
    HalvingRandomSearchCV
)
from sklearn.metrics import mean_absolute_error, r2_score

class ProjectSlipGBMPipeline:
    def __init__(
        self,
        features: List[str],
        n_candidates: int = 4,   # start with 4 candidate configs
        cv: int = 2,             # only 2-fold CV
        random_state: int = 42
    ):
        self.features = features
        self.n_candidates = n_candidates
        self.cv = cv
        self.random_state = random_state

        # Core model: handles missing values and early stopping
        self.model = HistGradientBoostingRegressor(
            early_stopping=True,
            random_state=random_state
        )

        # Wrap in a simple pipeline (for consistent API)
        self.pipeline = Pipeline([("model", self.model)])

        # **Do NOT include model__max_iter here** since that's our resource
        self.param_distributions: Dict[str, Any] = {
            "model__learning_rate": [0.05, 0.1],
            "model__max_depth": [5, 10],
            "model__max_leaf_nodes": [31, 63],
            "model__min_samples_leaf": [20, 50]
        }

        self.search: HalvingRandomSearchCV = None
        self.best_estimator_ = None

    @staticmethod
    def _clean_columns(df: pd.DataFrame) -> pd.DataFrame:
        def clean(col: str) -> str:
            c = re.sub(r"[^0-9A-Za-z]+", "_", col)
            c = re.sub(r"_{2,}", "_", c)
            return c.lower().strip("_")
        df = df.copy()
        df.columns = [clean(c) for c in df.columns]
        return df

    def _prepare(self, df: pd.DataFrame):
        df = self._clean_columns(df)
        complete = df[df["actual_duration_days"].notna()].reset_index(drop=True)
        inprog   = df[df["actual_duration_days"].isna()].reset_index(drop=True)

        complete["slip_days"] = (
            complete["actual_duration_days"]
            - complete["planned_duration_days"]
        )

        if complete.shape[0] < 2:
            raise ValueError(
                f"Need at least 2 completed projects; got {complete.shape[0]}"
            )

        Xc = complete[self.features]
        yc = complete["slip_days"].values
        Xi = inprog[self.features]
        return Xc, yc, Xi, complete, inprog

    def tune_and_fit(self, X: pd.DataFrame, y: pd.Series):
        # Successive halving uses model__max_iter as the budget dimension
        self.search = HalvingRandomSearchCV(
            estimator=self.pipeline,
            param_distributions=self.param_distributions,
            n_candidates=self.n_candidates,
            factor=2,
            resource="model__max_iter",
            max_resources=200,
            min_resources=100,
            cv=self.cv,
            scoring="neg_mean_absolute_error",
            random_state=self.random_state,
            n_jobs=-1,
            verbose=1
        )
        self.search.fit(X, y)
        self.best_estimator_ = self.search.best_estimator_
        print("✔️ Best params:", self.search.best_params_)

    def evaluate(self, X_train, y_train, X_test, y_test):
        y_pred = self.best_estimator_.predict(X_test)
        mae   = mean_absolute_error(y_test, y_pred)
        r2    = r2_score(y_test, y_pred)
        print(f"Hold-out MAE: {mae:.2f} days  |  R²: {r2:.3f}")
        return y_pred

    @staticmethod
    def plot_actual_vs_pred(y_true, y_pred):
        plt.figure(figsize=(6,6))
        plt.scatter(y_true, y_pred, alpha=0.5)
        lims = [min(y_true.min(), y_pred.min()), max(y_true.max(), y_pred.max())]
        plt.plot(lims, lims, "--", color="gray")
        plt.xlabel("Actual Slip Days")
        plt.ylabel("Predicted Slip Days")
        plt.title("Actual vs. Predicted Slip Days")
        plt.tight_layout()
        plt.show()

    def feature_importances(self):
        imp = self.best_estimator_.named_steps["model"].feature_importances_
        for feat, score in sorted(
            zip(self.features, imp), key=lambda x: x[1], reverse=True
        ):
            print(f"{feat:30s}: {score:.4f}")

    def predict_in_progress(self, inprog_df: pd.DataFrame):
        df = inprog_df.copy()
        df["predicted_slip_days"] = self.best_estimator_.predict(df[self.features])
        return df

    def save(self, path: str = "project_slip_gbm_pipeline.pkl"):
        joblib.dump(self.best_estimator_, path)
        print(f"✅ Pipeline saved to {path}")

    def run(self, dataset: pd.DataFrame):
        # Prepare data
        Xc, yc, Xi, complete, inprog = self._prepare(dataset)

        # Split into train/test
        X_train, X_test, y_train, y_test = train_test_split(
            Xc, yc, test_size=0.2, random_state=self.random_state
        )

        # Fast hyperparameter tuning + training
        self.tune_and_fit(X_train, y_train)

        # Evaluate & plot
        y_pred = self.evaluate(X_train, y_train, X_test, y_test)
        self.plot_actual_vs_pred(y_test, y_pred)

        # Feature importance
        print("\nFeature importances:")
        self.feature_importances()

        # Predict in-progress projects
        results = self.predict_in_progress(inprog)
        top10 = (
            results[["project_id","project_name","location","predicted_slip_days"]]
            .sort_values("predicted_slip_days", ascending=False)
            .head(10)
        )
        print("\nTop 10 At-Risk Projects:")
        print(top10.to_string(index=False))

        # Save pipeline
        self.save()
        return self, results

# Usage:
FEATURES = [
    "baseline_duration_days",
    "baseline_cost",
    "planned_duration_days",
    "planned_cost",
    "cost_performance_index_cpi",
    "schedule_performance_index_spi",
    "project_complexity"
]

predictor = ProjectSlipGBMPipeline(features=FEATURES)
predictor.run(dataset)
